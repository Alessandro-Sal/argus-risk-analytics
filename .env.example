# ============================================================
# ARGUS Risk & Wealth Analytics Platform — Environment Template
# Copia questo file in '.env' e popola con le tue credenziali segrete.
# NON committare mai il file '.env' effettivo nel version control.
# ============================================================

# ── 1. AI & LLM PROVIDERS ───────────────────────────────────
# Google Gemini API Key (Ottienila da Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Opzionale, per modelli GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# ── 2. MACROECONOMIC & MARKET DATA PROVIDERS ─────────────────
# Federal Reserve Economic Data (FRED) API Key (https://fred.stlouisfed.org/docs/api/api_key.html)
# Se lasciata vuota, ARGUS usa il feed pubblico CSV di FRED senza autenticazione
FRED_API_KEY=

# ── 3. CRITTOGRAFIA & SICUREZZA DATI A RIPOSO (GDPR Art. 32) ──
# Master Key per l'ArgusDataVault (cifratura AES-256 / Fernet di dati bancari e note sensibili)
# Genera una chiave casuale sicura a 32+ caratteri o usa un generatore crittografico
ARGUS_MASTER_KEY=

# Salt per la derivazione della chiave PBKDF2HMAC (opzionale, esadecimale o stringa casuale)
ARGUS_VAULT_SALT=

# Salt per la pseudonimizzazione deterministica dei log di audit (GDPR)
ARGUS_SALT=

# ── 4. DATABASE RELAZIONALE (MySQL / MariaDB) ────────────────
# Se MySQL non è raggiungibile, ARGUS effettua il fallback trasparente su SQLite locale (data/argus_local.db)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=investment_risk_bi
