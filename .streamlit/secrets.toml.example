# ============================================================
# ARGUS — Zero-Cost Cloud Configuration (.streamlit/secrets.toml)
# Copy this file to `.streamlit/secrets.toml` locally, or paste
# its contents into:
#   - Streamlit Community Cloud -> App Settings -> Secrets
#   - Hugging Face Spaces -> Settings -> Variables and secrets
# ============================================================

# 1. Supabase PostgreSQL Connection URI (Supavisor Transaction Pooler port 6543 or Session port 5432)
# Find in: Supabase Dashboard -> Connect -> Transaction pooler / Session pooler
SUPABASE_DB_URL = "postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"

# 2. Supabase Project API URL & Keys (Optional — used for Supabase Auth & Private PDF Storage Vault)
SUPABASE_URL = "https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_STORAGE_BUCKET = "tax-documents"

# 3. Access Control & Recruiter Demo Isolation for Public Cloud Deployments
# Set ARGUS_REQUIRE_LOGIN = "true" when deploying publicly so only you can access
# your real Supabase database, while recruiters/visitors can click "Modalità Demo Ospite".
ARGUS_REQUIRE_LOGIN = "false"
ARGUS_ADMIN_PASSWORD = "change-me-strong-password"
ARGUS_ENABLE_GUEST_DEMO = "true"
