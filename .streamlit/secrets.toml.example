# ============================================================
# ARGUS — Production Cloud Configuration (.streamlit/secrets.toml)
# Parità Trasparente tra Streamlit Community Cloud e Ambiente Locale
# ============================================================
# Istruzioni:
# - Su Streamlit Community Cloud: copia queste sezioni in "Settings -> Secrets"
# - In locale: copia questo file come `.streamlit/secrets.toml` (escluso da Git)
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. SUPABASE CLOUD & AUTH (Bootstrap Essenziale)
# ────────────────────────────────────────────────────────────
# Puoi configurare i parametri singolarmente o nella sezione [supabase]

SUPABASE_URL = "https://qsexxzbhtocxvyaijngb.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"
SUPABASE_PROJECT_REF = "qsexxzbhtocxvyaijngb"
SUPABASE_POOLER_HOST = "aws-0-eu-west-1.pooler.supabase.com"
SUPABASE_DB_PASSWORD = "your-supabase-db-password"

# Opzionale: URL di connessione PostgreSQL diretto (Transaction Pooler su porta 6543)
# SUPABASE_DB_URL = "postgresql://postgres.qsexxzbhtocxvyaijngb:your-db-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Opzionale: Service Role Key (solo per task backend / migrazioni speciali)
# SUPABASE_SERVICE_ROLE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# In alternativa, puoi usare la sintassi a tabella TOML [supabase]:
# [supabase]
# url = "https://qsexxzbhtocxvyaijngb.supabase.co"
# anon_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# db_password = "your-supabase-db-password"
# db_url = "postgresql://postgres.qsexxzbhtocxvyaijngb:your-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ────────────────────────────────────────────────────────────
# 2. CONTROLLO ACCESSO, LOGIN GATE & DEMO SANDBOX
# ────────────────────────────────────────────────────────────
# Imposta ARGUS_REQUIRE_LOGIN = "true" su Streamlit Cloud per bloccare
# la sidebar e le pagine finché l'utente non si autentica con Supabase Auth.
ARGUS_REQUIRE_LOGIN = "true"
ARGUS_ENABLE_GUEST_DEMO = "true"
ARGUS_ADMIN_PASSWORD = "your-master-admin-password"

# ────────────────────────────────────────────────────────────
# 3. GOOGLE SHEETS SYNC (Zero-File Dependency in Memory)
# ────────────────────────────────────────────────────────────
# Livello 1: Puoi inserire direttamente qui il Service Account GCP.
# In alternativa, puoi non inserirlo qui e caricarlo/incollarlo direttamente
# dalla UI della Wealth Control Room (verrà salvato nel Cloud Vault su Supabase).

# Opzione A: Tabella TOML dedicata [gcp_service_account]
# [gcp_service_account]
# type = "service_account"
# project_id = "your-gcp-project-id"
# private_key_id = "your-private-key-id"
# private_key = "your-service-account-private-key-pem"
# client_email = "argus-sync@your-gcp-project.iam.gserviceaccount.com"
# client_id = "123456789012345678901"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/argus-sync%40your-gcp-project.iam.gserviceaccount.com"

# Opzione B: Stringa JSON serializzata (equivalente a GOOGLE_SERVICE_ACCOUNT_JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON = '{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'
